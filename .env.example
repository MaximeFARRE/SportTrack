# Copy this file to .env and fill in your own values.
# Never commit .env — it is listed in .gitignore.

APP_NAME=SportTrack
APP_VERSION=0.2.0
DEBUG=false

# ---------- Database ----------
# Use the Supabase Postgres pooler URL (port 6543).
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./sporttrack.db

# ---------- Supabase ----------
# Find these in Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                 # secret — server-side only
SUPABASE_JWT_SECRET=                       # used to verify access tokens

# ---------- Web base URL ----------
WEB_BASE_URL=http://localhost:3000

# ---------- Shared internal secret (Next ↔ FastAPI) ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SECRET=

# ---------- Encryption for OAuth tokens at rest ----------
ENCRYPTION_KEY=

# ---------- Strava OAuth — https://www.strava.com/settings/api ----------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_SCOPE=read,activity:read_all

# ---------- Terra API — https://dashboard.tryterra.co ----------
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_WEBHOOK_SECRET=

# ---------- Anthropic (Claude coach) ----------
ANTHROPIC_API_KEY=
