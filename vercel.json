{
  "buildCommand": "cd web && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "web/.next",
  "framework": "nextjs",
  "installCommand": "echo skip",
  "rewrites": [
    { "source": "/api/py/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/daily-risk",   "schedule": "0 6 * * *" },
    { "path": "/api/cron/daily-injury", "schedule": "15 6 * * *" }
  ]
}
