{
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/cron/daily-risk.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/cron/daily-injury.py",
      "use": "@vercel/python"
    }
  ],
  "crons": [
    { "path": "/api/cron/daily-risk",   "schedule": "0 6 * * *" },
    { "path": "/api/cron/daily-injury", "schedule": "15 6 * * *" }
  ]
}
