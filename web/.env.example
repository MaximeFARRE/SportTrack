# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Backend FastAPI (server-side only)
FASTAPI_URL=http://localhost:8000

# Shared secret between Next.js and FastAPI for internal /internal/* endpoints
INTERNAL_SECRET=replace-with-a-long-random-string

# Strava (public client id can stay public; secret stays on FastAPI side)
STRAVA_CLIENT_ID=

# Monitoring (optional — leave empty in development)
NEXT_PUBLIC_SENTRY_DSN=
