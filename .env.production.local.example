# ============================================================
# Copie ce fichier en .env.production.local et remplis les valeurs.
# Ce fichier-ci EST commité (valeurs vides = safe).
# .env.production.local est dans .gitignore → jamais commité.
# ============================================================
# Puis lance :  bash scripts/push_env_to_vercel.sh

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=
# Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# ── URLs ────────────────────────────────────────────────────
# URL publique de ton app Vercel (sans slash final)
NEXT_PUBLIC_BASE_URL=https://VOTRE_PROJET.vercel.app
WEB_BASE_URL=https://VOTRE_PROJET.vercel.app
# L'API Python est montée ici sur Vercel
FASTAPI_URL=https://VOTRE_PROJET.vercel.app/api/index

# ── Secrets internes ────────────────────────────────────────
# Génère avec : openssl rand -hex 32
INTERNAL_SECRET=
ENCRYPTION_KEY=

# ── Strava OAuth ────────────────────────────────────────────
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://VOTRE_PROJET.vercel.app/api/strava/callback
STRAVA_SCOPE=read,activity:read_all

# ── Terra (Garmin / Polar / Fitbit …) ───────────────────────
# https://tryterra.co/dashboard
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_WEBHOOK_SECRET=

# ── Anthropic ────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Supabase DB (pour FastAPI SQLModel) ─────────────────────
# Supabase → Project Settings → Database → Connection string → Session pooler
# Format : postgresql://postgres.REF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Monitoring (optionnel) ───────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
